[menu]
menuitem=FULL, Windows 95 - LS-120 and Nero loaded
menuitem=LEAN, Windows 95 - LS-120 and Nero off (less locked RAM)
menuitem=SAFE, Windows 95 Safe Mode - INBRDPC.SYS loaded, LS-120 and Nero off
menudefault=FULL,5

