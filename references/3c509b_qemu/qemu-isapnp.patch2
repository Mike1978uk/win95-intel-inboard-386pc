diff -Nur --exclude=RCS --exclude=CVS --exclude=SCCS --exclude=BitKeeper --exclude=ChangeSet /home/antony/repositories/qemu-cvs/vl.c isapnp/vl.c
--- /home/antony/repositories/qemu-cvs/vl.c	2004-07-15 12:15:03 +01:00
