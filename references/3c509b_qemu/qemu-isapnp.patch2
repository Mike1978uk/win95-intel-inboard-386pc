diff -Nur --exclude=RCS --exclude=CVS --exclude=SCCS --exclude=BitKeeper --exclude=ChangeSet /home/antony/repositories/qemu-cvs/Makefile.target isapnp/Makefile.target
--- /home/antony/repositories/qemu-cvs/Makefile.target	2004-07-15 12:15:03 +01:00
