diff --git a/src/device/inboard386.c b/src/device/inboard386.c
index 34468acae..8a0f35656 100644
--- a/src/device/inboard386.c
+++ b/src/device/inboard386.c
@@ -87,6 +87,9 @@ typedef struct inboard386_t {
                                            inboard386_init() for why this exists: real hardware's
                                            shadow-RAM self-patch writes through this alias, not
                                            through 0xF0000 directly. */
+    uint8_t      *bios_alias_ram;      /* Backing for the BIOS half of the reserved block as
+                                           seen through the HIGH window. Deliberately NOT
+                                           bios_shadow_ram - see the mapping comment below. */
     uint8_t      *video_shadow_ram;    /* Backing for the video/EGA half of the reserved
                                            block. Behaves as ordinary RAM: unlike the BIOS
                                            window there is no ROM to steer reads to. */
@@ -467,6 +470,34 @@ inboard386_apply_rom_shadow(UNUSED(inboard386_t *dev))
    version's fix (pre-populating bios_shadow_ram with a real ROM copy at init) was
    necessary but insufficient - the shadow RAM self-test still failed, because it's not
    simply asking "does a read return ROM content" - see the read/write split below. */
+/* The BIOS half of the reserved block, as seen through the HIGH window at
+   INBOARD_SHADOW_ALIAS. Plain RAM in both directions, and backed by its OWN buffer rather than
+   by bios_shadow_ram.
+
+   Why a separate buffer: the driver's extended-memory diagnostic writes a walking test pattern
+   through this window (measured - it walks the reserved block byte by byte). If those writes
+   land in bios_shadow_ram they destroy the shadowed BIOS copy, and the low 0xF0000 window then
+   serves the test pattern as executable code - the guest resets a few seconds after the driver
+   loads. Reproduced twice before this buffer was split out.
+
+   The shadow self-test is satisfied either way: it checks that RAM is present and readable here,
+   not that this window and the low one share storage - consistent with the trace, which shows
+   the driver never reading this window back through 0xF0000. Pre-populated with the ROM image
+   for the same reason bios_shadow_ram is. */
+static uint8_t
+inboard386_bios_alias_read(uint32_t addr, void *priv)
+{
+    const inboard386_t *dev = (inboard386_t *) priv;
+    return dev->bios_alias_ram[addr & 0xffff];
+}
+
+static void
+inboard386_bios_alias_write(uint32_t addr, uint8_t val, void *priv)
+{
+    inboard386_t *dev = (inboard386_t *) priv;
+    dev->bios_alias_ram[addr & 0xffff] = val;
+}
+
 /* The video/EGA half of the reserved block. Straight RAM in both directions - the driver's
    memory diagnostic writes a pattern here and reads it back, and with no mapping at all it
    read 0xFF and the block was marked bad. */
@@ -667,6 +698,7 @@ inboard386_init(const device_t *info)
 
     dev->bios_shadow_ram   = (uint8_t *) calloc(1, 0x10000); /* 64KB - system BIOS shadow window only */
     dev->video_shadow_ram  = (uint8_t *) calloc(1, 0x10000); /* 64KB - the video/EGA half of the reserved block */
+    dev->bios_alias_ram    = (uint8_t *) calloc(1, 0x10000); /* 64KB - the BIOS half, high window only */
     dev->bios_rom_snapshot = (uint8_t *) calloc(1, 0x10000);
 
     /* 2026-07-26: corrected to cover ONLY the system BIOS window (F0000-FFFFF, 64KB), not the
@@ -691,6 +723,7 @@ inboard386_init(const device_t *info)
         uint8_t b                  = mem_readb_phys(0xf0000 + a);
         dev->bios_rom_snapshot[a]  = b;
         dev->bios_shadow_ram[a]    = b;
+        dev->bios_alias_ram[a]     = b;
     }
 
     /* "ROM BIOS shadow RAM failed" - SUPERSEDED (2026-07-26, later same day): the "ROM is
@@ -765,9 +798,9 @@ inboard386_init(const device_t *info)
        range silently landed nowhere (read back as 0xFF, 86Box's "no mapping at all" default)
        regardless of mem_mapping_enable() being re-asserted every reset. */
     mem_mapping_add(&dev->bios_shadow_alias_mapping, INBOARD_SHADOW_ALIAS, 0x10000,
-                     inboard386_bios_shadow_read, NULL, NULL,
-                     inboard386_bios_shadow_write, NULL, NULL,
-                     dev->bios_shadow_ram, 0, dev);
+                     inboard386_bios_alias_read, NULL, NULL,
+                     inboard386_bios_alias_write, NULL, NULL,
+                     dev->bios_alias_ram, 0, dev);
     mem_mapping_enable(&dev->bios_shadow_alias_mapping);
 
     /* Second half of the card's 128 KB reserved block. Without it, stock INBRDPC.SYS's
@@ -833,6 +866,7 @@ inboard386_close(void *priv)
     if (dev->is_xt)
         pic_set_force_xt_imr_timing(0);
 
+    free(dev->bios_alias_ram);
     free(dev->video_shadow_ram);
     free(dev->bios_shadow_ram);
     free(dev->bios_rom_snapshot);
