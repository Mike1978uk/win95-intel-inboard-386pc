+/* SCRATCH DIAGNOSTIC - never commit */
+static void
+el3diag_frame(const char *tag, const uint8_t *b, int len)
+{
+    static int n[2];
+    int        k = (tag[0] == 'T');
+    char       hex[3 * 96 + 1];
+    int        m = (len < 96) ? len : 96;
+
+    if (n[k]++ >= 80)
+        return;
+    for (int i = 0; i < m; i++)
+        sprintf(hex + 3 * i, "%02x ", b[i]);
+    hex[3 * m] = 0;
+    pclog("EL3DIAG %s %d: %s\n", tag, len, hex);
+}
