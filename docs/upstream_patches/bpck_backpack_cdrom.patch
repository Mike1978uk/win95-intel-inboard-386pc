diff --git a/src/io.c b/src/io.c
index dfd5215d3..00c4423de 100644
--- a/src/io.c
+++ b/src/io.c
@@ -77,6 +77,64 @@ io_log(const char *fmt, ...)
 #    define io_log(fmt, ...)
 #endif
 
+/* Access-width tally for one port window.
+   ENABLE_IO_LOG logs every access in the machine, which is unusable across a
+   Windows boot; this counts one named window by width, which is what "did the
+   driver issue 32-bit accesses" actually needs. Off unless IOWIDTH_BASE is
+   set, so it costs one compare when unused. Diagnostic: remove it once the
+   question is answered. */
+static int      iow_base = -1;
+static unsigned iow_len  = 8;
+static uint64_t iow_in[3];   /* slot 0/1/2 = 1/2/4 bytes */
+static uint64_t iow_out[3];
+
+static void
+iowidth_dump(void)
+{
+    const char *path = getenv("IOWIDTH_OUT");
+    FILE       *f;
+
+    if (iow_base < 0)
+        return;
+    f = fopen(path ? path : "iowidth.txt", "w");
+    if (f == NULL)
+        return;
+    fprintf(f, "window %04X..%04X\n", (unsigned) iow_base,
+            (unsigned) (iow_base + (int) iow_len - 1));
+    fprintf(f, "width  in            out\n");
+    for (int i = 0; i < 3; i++)
+        fprintf(f, "%-5d  %-12llu  %llu\n", 1 << i,
+                (unsigned long long) iow_in[i], (unsigned long long) iow_out[i]);
+    fclose(f);
+}
+
+static void
+iowidth_tally(uint16_t port, int slot, int is_out)
+{
+    static int armed = 0;
+
+    if (!armed) {
+        const char *b = getenv("IOWIDTH_BASE");
+        const char *l = getenv("IOWIDTH_LEN");
+
+        armed = 1;
+        if (b == NULL)
+            return;
+        iow_base = (int) strtol(b, NULL, 16);
+        if (l != NULL)
+            iow_len = (unsigned) strtoul(l, NULL, 10);
+        atexit(iowidth_dump);
+    }
+    if (iow_base < 0)
+        return;
+    if ((port < iow_base) || (port >= (iow_base + (int) iow_len)))
+        return;
+    if (is_out)
+        iow_out[slot]++;
+    else
+        iow_in[slot]++;
+}
+
 void
 io_init(void)
 {
@@ -340,6 +398,7 @@ inb(uint16_t port)
     uint8_t qfound = 0;
 #endif
 
+    iowidth_tally(port, 0, 0);
     io_port = port;
 
 #ifdef USE_DEBUG_REGS_486
@@ -406,6 +465,7 @@ outb(uint16_t port, uint8_t val)
