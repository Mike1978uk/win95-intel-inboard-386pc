+
+/* Game-style effects: a short buffer started again every 100 ms. */
+static DWORD WINAPI ds_shots( LPVOID unused )
+{
+    (void)unused;
+    while( ds_run ) {
+        if( ds_shot != NULL ) {
+            ds_shot->v->SetCurrentPosition( ds_shot, 0 );
