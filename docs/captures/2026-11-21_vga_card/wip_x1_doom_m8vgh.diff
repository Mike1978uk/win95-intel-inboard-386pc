+static DSB *ds_buffer( DWORD bytes, int tone )
+{
+    WAVEFORMATEX    wf;
+    DSBDESC         d;
+    DSB             *b = NULL;
+    LPVOID          p1;
+    LPVOID          p2;
+    DWORD           n1;
+    DWORD           n2;
+    DWORD           i;
+
+    memset( &wf, 0, sizeof( wf ) );
+    wf.wFormatTag = WAVE_FORMAT_PCM;
+    wf.nChannels = 1;
+    wf.nSamplesPerSec = DS_RATE;
+    wf.nAvgBytesPerSec = DS_RATE;
+    wf.nBlockAlign = 1;
+    wf.wBitsPerSample = 8;
+    memset( &d, 0, sizeof( d ) );
+    d.dwSize = sizeof( d );
+    d.dwBufferBytes = bytes;
+    d.lpwfxFormat = &wf;
