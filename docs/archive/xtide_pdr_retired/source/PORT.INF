; PORT.INF - Phase 0 probe for issue #21, IBM 5160 + Intel Inboard 386/PC.
;
; This installs NOTHING USEFUL. Its only job is to create a device node so that IOS has a
; reason to load PORT.PDR, which is Microsoft's DDK sample port driver built unchanged
; (bar the IRQ registration - see phase0-no-irq.patch). The sample claims no devices, so
; the expected outcome is that IOS loads it, calls it, gets nothing, and drops it.
;
; The result we are after is one line in a logged boot:
;
;     Initing port.pdr
;
; That proves the whole chain works before a single line of XT-IDE code is written.
;
; RESOURCES - phase 1.
;   IOConfig  300-31F, ConfigPriority=HARDRECONFIG. Measured base, 2026-08-30: the
;             XTIDE BIOS banner says "master at 300h" and 0x30E reads 50h (DRDY|DSC).
;             HARDRECONFIG, never HARDWIRED - HARDWIRED is exactly what made the stock
;             *PNP0600 node claim an unchangeable IRQ 14 on this machine. A wrong
;             resource you can edit is recoverable; one you cannot is a reinstall.
;             Exactly ONE IO descriptor: Port_Scan_Inp_Params loops over every
;             ResType_IO it finds and keeps the LAST one, so a second range would
;             silently win. The range is 32 ports, not 16: on the stride-2 Lo-tech
;             XT-CF the alternate status register sits at base+14*2 = 0x31C.
;   No IRQConfig - the card is jumpered without an interrupt and the driver polls.
;             The sample's VPICD registration is removed for the same reason (#22 is
;             a recent lesson in what a stray IRQ claim costs on this machine).
;   No DMAConfig - 8237 channel 0 is DRAM refresh on a 5160, and XT-CF DMA mode is
;             XT-CFv3-only anyway. Nothing here touches the 8237.
;
; CLASS: hdc, not SCSIAdapter. An earlier draft used SCSIAdapter because that is what
; T130-XT.INF and the LS-120 INF use, and both are proven to bind on this machine - but
; those are .MPD MINIPORTS, loaded by SCSIPORT.PDR. This is a standalone .PDR port driver
; registering DRP_MISC_PD directly with IOS, architecturally the same as ESDI_506.PDR and
; HSFLOP.PDR, both of which are hdc/floppy class. Under SCSIAdapter the class installer may
; hand it to SCSIPORT and fail for reasons that say nothing about our binary.
;
; The two registry values below are taken verbatim from MSHDC.INF's own [ESDI_AddReg],
; which is how Microsoft binds ESDI_506.PDR - the driver this one eventually replaces.
;
; HARDWARE ID: deliberately NOT *PNP0600. Microsoft's IDE entries use that, and a node
; claiming to be a standard IDE controller is one Windows may try to drive the boot disk
; with. Ours is a private ID nothing else matches.
;
; Install: Add New Hardware -> No, I want to select from a list -> Hard disk controllers ->
;          Have Disk -> type the path, do not Browse (issue #3). DECLINE autodetection.
; Remove:  Device Manager -> remove the node, and delete WINDOWS\SYSTEM\IOSUBSYS\PORT.PDR.

[Version]
signature="$CHICAGO$"
Class=hdc
; Taken verbatim from MSHDC.INF in the same install - the stock hdc INF that
; Have Disk accepts. Without it Setup answers "The specified location does not
; contain information about your hardware" and never lists the model.
ClassGUID={4d36e96a-e325-11ce-bfc1-08002be10318}
Provider=%INB%

; Harmless if the class is already registered, which it will be - MSHDC.INF is present.
[ClassInstall]
AddReg=HDC_Class

[HDC_Class]
HKR,,,,%HDCClassName%
HKR,,Icon,,-9

[Manufacturer]
%INB%=INBOARD

[INBOARD]
%PORTPROBE%=PORTPROBE_INST,INBOARD_XTIDE_PROBE

[PORTPROBE_INST]
LogConfig=PORT.LogConfig
CopyFiles=@PORT.PDR
AddReg=IOS, PORT_REG

[PORT.LogConfig]
ConfigPriority=HARDRECONFIG
IOConfig=300-31F(3FF::)

[PORT_REG]
HKR,,DriverDesc,,"XT-IDE Port Driver"
HKR,,PortDriver,,PORT.PDR
; Transport override, for a card autodetect gets wrong. 0=auto 1=latch 2=PIO8.
; NOT YET READ BY THE DRIVER - phase 1 autodetects only. Left commented rather
; than shipping a value that silently does nothing.
;HKR,,Transport,1,00

[IOS]
HKR,,DevLoader,,*IOS

[DestinationDirs]
DefaultDestDir=12

[SourceDisksFiles]
PORT.PDR = 1

[SourceDisksNames]
1 = "XT-IDE port driver",,

[Strings]
HDCClassName="Hard disk controllers"
INB="86Box-Inboard project"
PORTPROBE="Lo-tech XT-CF / XT-IDE 8-bit disk controller"
