+	// A hosted LUN is never selected by its own ID; it answers as LUN
+	// hostedLun behind hostId. 0 = an ordinary device.
+	uint8_t hostId;
+	uint8_t hostedLun;
+
+	uint8_t reserved[58]; // Pad out to 128 bytes for main section.
 } S2S_TargetCfg;
 
 static inline uint8_t s2s_getTargetId(const S2S_TargetCfg *cfg) {
diff --git a/lib/SCSI2SD/src/firmware/scsi.c b/lib/SCSI2SD/src/firmware/scsi.c
index bc01ac8..33ac008 100755
--- a/lib/SCSI2SD/src/firmware/scsi.c
+++ b/lib/SCSI2SD/src/firmware/scsi.c
@@ -596,6 +596,27 @@ static void process_Command()
 	}
 
 
+	if (scsiDev.lun > 0)
+	{
+		int tgtIndex;
+		for (tgtIndex = 0; tgtIndex < S2S_MAX_TARGETS; ++tgtIndex)
+		{
+			const S2S_TargetCfg* hosted = scsiDev.targets[tgtIndex].cfg;
+			if (hosted && hosted->hostedLun == scsiDev.lun &&
+				hosted->hostId == scsiDev.target->targetId)
+			{
+				scsiDev.target = &scsiDev.targets[tgtIndex];
+				scsiDev.lun = 0;
+				// Selection only clears unit attention on the LUN 0 slot.
+				if (scsiDev.compatMode == COMPAT_SCSI1)
+				{
+					scsiDev.target->unitAttention = 0;
+				}
+				break;
+			}
+		}
+	}
+
 	// For Philips P2000C with Xebec S1410 SASI/MFM adapter
 	// http://bitsavers.trailing-edge.com/pdf/xebec/104524C_S1410Man_Aug83.pdf
 	if ((scsiDev.lun > 0) && (scsiDev.boardCfg.flags & S2S_CFG_MAP_LUNS_TO_IDS))
@@ -953,7 +974,8 @@ static void process_SelectionPhase()
 	TargetState* target = NULL;
 	for (tgtIndex = 0; tgtIndex < S2S_MAX_TARGETS; ++tgtIndex)
 	{
-		if (scsiDev.targets[tgtIndex].targetId == (selStatus & S2S_CFG_TARGET_ID_BITS))
+		if (scsiDev.targets[tgtIndex].targetId == (selStatus & S2S_CFG_TARGET_ID_BITS) &&
+			!scsiDev.targets[tgtIndex].cfg->hostedLun)
 		{
 			target = &scsiDev.targets[tgtIndex];
 			break;
diff --git a/src/BlueSCSI.cpp b/src/BlueSCSI.cpp
