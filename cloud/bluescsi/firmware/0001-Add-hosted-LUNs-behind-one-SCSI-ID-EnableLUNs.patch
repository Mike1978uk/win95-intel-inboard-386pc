 lib/SCSI2SD/include/scsi2sd.h            |   7 +-
 lib/SCSI2SD/src/firmware/scsi.c          |  24 +++++-
 src/BlueSCSI.cpp                         | 104 ++++++++++++++++++++++-
 src/BlueSCSI_disk.cpp                    |   2 +-
 src/BlueSCSI_log_trace.cpp               |   4 +-
 src/BlueSCSI_settings.cpp                |  26 +++++-
 src/BlueSCSI_settings.h                  |   7 ++
 8 files changed, 167 insertions(+), 10 deletions(-)

