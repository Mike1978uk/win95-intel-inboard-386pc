+  {
+    g_scsi_settings.setHostedLun(i, 0, 0);
+  }
 #ifdef BLUESCSI_BUTTONS
   uint8_t eject_btn_set = 0;
   uint8_t last_removable_device = 255;
@@ -500,6 +541,15 @@ bool findHDDImages()
         }
