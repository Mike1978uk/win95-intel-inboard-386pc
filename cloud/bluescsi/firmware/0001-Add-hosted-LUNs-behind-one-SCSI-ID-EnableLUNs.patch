       }
+      else if (hosted_pending && !hosted_pass)
+      {
+        hosted_pass = true;
+        dirindex = 0;
+        ini_gets("SCSI", "Dir", "/", imgdir, sizeof(imgdir), CONFIGFILE);
+        logmsg("=== Finding hosted LUN images in ", imgdir, " ===");
+        root.open(imgdir);
+        continue;
+      }
       else
       {
         break;
@@ -511,6 +561,8 @@ bool findHDDImages()
       file.getName(name, MAX_FILE_PATH+1);
       file.close();
 
+      if (hosted_pass && hostedLunFromName(name) == 0) continue;
+
       // Special filename for clearing any previously programmed ROM drive
       if(strcasecmp(name, "CLEAR_ROM") == 0)
       {
@@ -622,6 +674,34 @@ bool findHDDImages()
           }
         }
 
+        // From here on a hosted LUN uses its slot number as its id.
+        int host_id = id;
+        int hosted_lun = hostedLunFromName(name);
+        if (hosted_lun > 0 && !hosted_pass)
+        {
+          hosted_pending = true;
+          continue;
+        }
+        if (hosted_lun > 0)
+        {
+          int slot = findFreeSlot();
+          if (slot < 0)
+          {
+            logmsg("-- Ignoring ", name, ", no free device slot for ID ", host_id, " LUN ", hosted_lun);
+            continue;
+          }
+          if (hostedLunExists(host_id, hosted_lun))
+          {
+            logmsg("-- Ignoring ", name, ", ID ", host_id, " LUN ", hosted_lun, " is already in use!");
+            continue;
+          }
+          if (!s2s_getConfigById(host_id))
+          {
+            logmsg("---- Warning: ID ", host_id, " has no LUN 0 image, hosts may not scan its LUNs");
+          }
+          id = slot;
+        }
+
         // Add the directory name to get the full file path
         char fullname[MAX_FILE_PATH * 2 + 2] = {0};
         strncpy(fullname, imgdir, MAX_FILE_PATH);
@@ -664,9 +744,18 @@ bool findHDDImages()
         if (is_zp) type = S2S_CFG_ZIP100;
         if (is_pr) type = S2S_CFG_PRINTER;
 
+        if (hosted_lun > 0)
+        {
+          g_scsi_settings.setHostedLun(id, host_id, hosted_lun);
+        }
         g_scsi_settings.initDevice(id & (NUM_SCSIID - 1), type);
         // Open the image file
-        if (id < NUM_SCSIID && is_romdrive)
+        if (hosted_lun > 0 && is_romdrive)
+        {
+          logmsg("-- Ignoring ", fullname, ", a ROM drive cannot be a hosted LUN");
+          g_scsi_settings.setHostedLun(id, 0, 0);
+        }
+        else if (id < NUM_SCSIID && is_romdrive)
         {
           logmsg("-- Loading ROM drive from ", fullname, " for id:", id);
           imageReady = scsiDiskProgramRomDrive(fullname, id, blk, type);
@@ -687,10 +776,18 @@ bool findHDDImages()
           if(imageReady)
           {
             foundImage = true;
+            if (hosted_lun > 0)
+            {
+              image_config_t &img = scsiDiskGetImageConfig(id);
+              img.hostId = host_id;
+              img.hostedLun = hosted_lun;
+              logmsg("---- Hosted as ID ", host_id, " LUN ", hosted_lun, " in slot ", id);
+            }
           }
           else
           {
             logmsg("---- Failed to load image");
+            g_scsi_settings.setHostedLun(id, 0, 0);
           }
         } else {
           logmsg("-- Invalid lun or id for image ", fullname);
@@ -717,6 +814,11 @@ bool findHDDImages()
     {
       int capacity_kB = ((uint64_t)cfg->scsiSectors * cfg->bytesPerSector) / 1024;
 
+      if (cfg->hostedLun)
+      {
+        logmsg("Slot ", i, " is ID ", (int)cfg->hostId, " LUN ", (int)cfg->hostedLun, ":");
+      }
+
       if (cfg->deviceType == S2S_CFG_NETWORK || cfg->deviceType == S2S_CFG_AMIGAWIFI ||
           cfg->deviceType == S2S_CFG_PRINTER)
       {
