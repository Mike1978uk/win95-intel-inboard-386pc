 }
 
+// LUN 1-7 named by the fourth character (HD51...), when EnableLUNs is set.
+static int hostedLunFromName(const char *name)
+{
+  if (!g_scsi_settings.getSystem()->enableLUNs || strlen(name) <= HDIMG_LUN_POS)
+    return 0;
+  int id = scsiDecodeID(name[HDIMG_ID_POS]);
+  if (id < 0 || id >= NUM_SCSIID)
+    return 0;
+  int lun = name[HDIMG_LUN_POS] - '0';
+  return (lun >= 1 && lun <= 7) ? lun : 0;
+}
+
+static int findFreeSlot()
+{
+  for (int i = 0; i < S2S_MAX_TARGETS; i++)
+  {
+    if (!s2s_isTargetEnabled(s2s_getConfigByIndex(i)))
+      return i;
+  }
+  return -1;
+}
+
+static bool hostedLunExists(int host_id, int lun)
+{
+  for (int i = 0; i < S2S_MAX_TARGETS; i++)
+  {
+    const S2S_TargetCfg *cfg = s2s_getConfigByIndex(i);
+    if (s2s_isTargetEnabled(cfg) && cfg->hostId == host_id && cfg->hostedLun == lun)
+      return true;
+  }
+  return false;
+}
+
 // Iterate over the root path in the SD card looking for candidate image files.
 bool findHDDImages()
 {
@@ -470,6 +503,14 @@ bool findHDDImages()
   bool foundImage = false;
   int usedDefaultId = 0;
   uint8_t removable_count = 0;
+  // Hosted LUNs are placed in a second pass, so they only take slots that no
+  // LUN 0 image claimed.
+  bool hosted_pending = false;
+  bool hosted_pass = false;
