+void BlueSCSISettings::setHostedLun(uint8_t scsiId, uint8_t hostId, uint8_t lun)
+{
+    m_hostId[scsiId] = hostId;
+    m_hostedLun[scsiId] = lun;
+}
+
+void BlueSCSISettings::deviceSection(uint8_t scsiId, char *section, size_t len)
+{
+    if (m_hostedLun[scsiId])
+        snprintf(section, len, "SCSI%dL%d", (int)m_hostId[scsiId], (int)m_hostedLun[scsiId]);
+    else
+        snprintf(section, len, "SCSI%d", (int)scsiId);
+}
