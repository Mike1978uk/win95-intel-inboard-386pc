build/
# ...but the custom VKD is a deliverable, not a build artefact: deploy_premonolith.sh
# depends on it, so a clone without it cannot run the deploy.
!custom_vkd/build/
!custom_vkd/build/*.VXD
*.o
*.exe
test-images/*.img
test-images/*.bin
!test-images/README.md
vcpkg_installed/
.vscode/
.idea/

# VM disk images and runtime logs: large/local-only, not versioned.
# Golden copies live at Desktop\Claude_stuff\86box_inboard_test\vm_win311\
# (see memory/recovery_plan_2026_07_31.md) - keep 86box.cfg tracked, not the image.
vm_win311/*.img
vm_win311/**/*.img
vm_win311/*.log
vm_win311/*.bin
vm_win311/vram_dump.txt
vm_win311/nvr/
vm_win311/printer/
vm_win311/screenshots/
vm_win311/roms/

# Windows 95 disk images: tens of GB, and contain copyrighted Microsoft/Intel media -
# never versioned. Patches/build scripts/source live in vxd-patches/, custom_vkd/, ivt68fix/.
vm_win95_osr1/
vm_win95_at_gap/

# Live investigation traces — regenerated by every emulator run, never worth committing
live_*.txt
*_dump.txt
*_dump.bin
seg*_trace.txt
a0a1trace.txt
device_add_order.txt

# Python bytecode
__pycache__/
*.pyc
