build/
# ...but the custom VKD is a deliverable, not a build artefact: deploy_premonolith.sh
# depends on it, so a clone without it cannot run the deploy.
!custom_vkd/build/
!custom_vkd/build/*.VXD
*.o
*.exe
# ...but CTCHIP34 is a deliverable, not a build artefact. It is the tool that
# sets this machine's CPU registers (issue #9) and CPUSET.BAT is useless
# without it; `*.exe` above had silently kept it out of the repo.
!dist/post-install-fixes/ctchip34/CTCHIP34.EXE
test-images/*.img
test-images/*.bin
!test-images/README.md
vcpkg_installed/
.vscode/
.idea/

# VM disk images and runtime logs: large/local-only, not versioned.
# Golden copies live at Desktop\Claude_stuff\86box_inboard_test\vm_win311\
# (see memory/recovery_plan_2026_07_31.md) - keep 86box.cfg tracked, not the image.
vm_win311/*.img
vm_win311/**/*.img
vm_win311/*.log
vm_win311/*.bin
vm_win311/vram_dump.txt
vm_win311/nvr/
vm_win311/printer/
vm_win311/screenshots/
vm_win311/roms/

# Windows 95 disk images: tens of GB, and contain copyrighted Microsoft/Intel media -
# never versioned. Patches/build scripts/source live in vxd-patches/, custom_vkd/, ivt68fix/.
vm_win95_osr1/
vm_win95_at_gap/

# XT-IDE stride-1 test bed (issue #24). Throwaway 86Box working dir; the config
# that mattered is recorded in docs/xtide_register_maps.md, not here.
vm_xtide_stride1/

# Bed for booting a COPY of the real card's image (issue #22, 2026-09-19). Holds
# a 2 GB image; the result that mattered is
# docs/captures/2026-09-18_ls120/CR1_cardimage_enumerates_in_bed.log.
vm_cardrepro/

# Live investigation traces — regenerated by every emulator run, never worth committing
live_*.txt
*_dump.txt
*_dump.bin
seg*_trace.txt
a0a1trace.txt
device_add_order.txt

# Python bytecode
__pycache__/
*.pyc

# Stock upstream 86Box clone, built locally for clean-build testing. Disposable, never commit.
86box_upstream/

# Per-experiment VM directories. Each is a throwaway 86Box working dir (disk image, nvr,
# per-run stderr/stdout/vram dumps) created to isolate one variable. Local scratch: the
# config that matters gets recorded in docs/, the image never belongs in git.
# vm_win311/ is deliberately NOT here - it holds tracked deliverables (the Win 3.11 Inboard
# drivers IBKBD.DRV / IBVKD.386, and the INT 15h shim source).
vm_clean_epat/
vm_alias_*/
vm_fdd/
vm_fenix/
vm_golden/
vm_mousetest/
vm_qbr*/
vm_shadow/
vm_test_*/
vm_win30/
vm_1986mach8/
vm_win95_*/

# Per-run capture files left beside the VM dirs by the trace builds.
stderr_log*.txt
stdout_log*.txt
launch_std*.txt
autoclear_log.txt
screenshot_*.png
vram_probe.txt
inbrdpc_live_dump.bin
vram_dump*
nasm.zip
nasm-*/
bios_f000_dump_int15.bin

# Original vendor driver archives are deliverables, not build output.
!drivers/**/*.EXE

# Driver-load test bed for the XT-IDE .PDR (issue #21). Two 2 GB images plus
# per-run boot logs and screenshots; the config that matters is in
# docs/, not here.
vm_xtide_pdr/

# Per-experiment 86Box bed: 2 GB image plus multi-hundred-MB run logs.
vm_xtcf_faithful/

# T130B SCSI-stack control bed: two masters plus working copies, ~4 GB.
vm_t130b/

#  The SCSI miniport bed (issue #21). 2 GB images plus a master copy.
vm_xtide_mpd/

#  Clean-install bed for the miniport INF (issue #21).
vm_xtide_mpd2/
image_backups/*.img

# GPL reference sources - read for facts, never copied, never committed.
reference_gpl/

# throwaway probe scripts staged for the DOS box
scratch/

# Throwaway 86Box working directories and build trees (2026-09-13).
# 86box_master is a git worktree at upstream master, used to test a fix that
# has landed upstream without disturbing our own branch.
vm_ls120win/
vm_mach8_master/
86box_master/

# Build product of drivers/imation_ls120/tools/ecpprobe.py - regenerate, do not track
drivers/imation_ls120/tools/ECPPROBE.COM
.aider*
vm_bpck/
# Third-party clone (RonnyRoy's Inboard reproduction) - read it, do not vendor it
references/inboard386_ronnyroy/

# 3C509B work (#42): the 86Box worktree, its bed, and a clone of
# hackerb9/3C509B-nestor kept for reading.
86box_3c509b/
vm_3c509b/
references/3c509b_nestor/
